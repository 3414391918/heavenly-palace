    <div id="app"></div>
    <script type="module" src="/src/main.ts"></script>

    <!-- Vue 应用挂载检测 & 全局错误处理 -->
    <script>
      function hideLoadingIndicator() {
        var el = document.getElementById('loading-indicator');
        if (el) el.classList.add('hidden');
        var box = document.getElementById('error-message');
        if (box) box.classList.remove('show');
      }

      function showError(msg) {
        var box = document.getElementById('error-message');
        var txt = document.getElementById('error-text');
        if (box && txt) { txt.textContent = msg; box.classList.add('show'); }
      }

      // 主路径：Vue 主动派发 vue-app-mounted 事件
      var vueMounted = false;
      window.addEventListener('vue-app-mounted', function () {
        vueMounted = true;
        requestAnimationFrame(hideLoadingIndicator);
      });

      // 备用轮询：事件未触发时兜底。冷启动/依赖预热可能超过 10s，避免误报。
      window.addEventListener('load', function () {
        var startedAt = Date.now();
        var maxWaitMs = 30000;
        var timer = setInterval(function () {
          var app = document.getElementById('app');
          if (vueMounted || (app && app.innerHTML.trim())) {
            clearInterval(timer);
            requestAnimationFrame(hideLoadingIndicator);
          } else if (Date.now() - startedAt >= maxWaitMs) {
            clearInterval(timer);
            showError('Vue 应用未能成功挂载，请检查控制台。');
          }
        }, 200);
      });

      // 全局错误捕获
      window.addEventListener('error', function (e) {
        if (e.message && e.message.includes('ResizeObserver')) return; // 无害
        if (!e.error && !e.message) return; // 扩展/无关脚本
        console.error('❌ Global error:', e.error);
        if (e.error && e.error.message) showError('加载错误: ' + e.error.message);
      });

      window.addEventListener('unhandledrejection', function (e) {
        var reason = e.reason;
        var msg;
        if (reason instanceof Error) { msg = reason.stack || reason.message; }
        else if (reason && typeof reason === 'object') {
          try { msg = JSON.stringify(reason); } catch (_) { msg = String(reason); }
        } else { msg = String(reason); }
        console.error('❌ Unhandled rejection:', msg);
        if (reason && reason.message) showError('加载错误: ' + reason.message);
      });
    </script>
  </body>
</html>
