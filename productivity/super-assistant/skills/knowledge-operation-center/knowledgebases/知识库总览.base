filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("5-系统模板")'
    - note["来源追溯"] != null
properties:
  file.name:
    displayName: 知识条目
  note.审查状态:
    displayName: 审查状态
  note.来源追溯:
    displayName: 来源追溯
  note.修改时间:
    displayName: 修改时间
views:
  - type: table
    name: 全库
    order:
      - file.name
      - 审查状态
      - 来源追溯
      - 修改时间
  - type: table
    name: 待审查
    filters:
      and:
        - note["审查状态"] == "待审查"
    order:
      - file.name
      - 来源追溯
      - 修改时间
  - type: table
    name: 已确认
    filters:
      and:
        - note["审查状态"] == "已确认"
    order:
      - file.name
      - 来源追溯
      - 修改时间
  - type: table
    name: 最近修改
    order:
      - file.name
      - 审查状态
      - 修改时间
    sort:
      - property: 修改时间
        direction: DESC
    limit: 20
